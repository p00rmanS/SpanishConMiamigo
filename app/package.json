{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "lint": "eslint src",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "pretest": "npm run build",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.mjs\""
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "^6.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.10"
  }
}
